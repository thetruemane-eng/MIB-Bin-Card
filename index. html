// VIEW 8: TEAM MANAGEMENT (Admin Only)
function renderTeam(app){
  app.innerHTML = `
    <div class="card">
      <div class="section-label">👥 Team Member Roles</div>
      <div class="hint">Manage user privileges and nicknames across the team.</div>
      <div class="overflow">
        <table>
          <thead><tr><th>User ID</th><th>Nickname</th><th>Role</th><th>Action</th></tr></thead>
          <tbody>
            ${state.roles.map(r=>`
              <tr>
                <td><code>${esc(r.id)}</code>${r.id===myId?'(You)':''}</td>
                <td>${esc(r.nickname||'Unnamed')}</td>
                <td><strong>${esc(r.role)}</strong></td>
                <td>
                  ${r.id !== myId ? `
                    <button class="btn secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="toggleRole('${r.id}', '${r.role}')">
                      Make ${r.role==='admin'?'Staff':'Admin'}
                    </button>
                  ` : '—'}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;
}

async function toggleRole(id, currentRole){
  const next = currentRole === 'admin' ? 'staff' : 'admin';
  await db.collection('roles').doc(id).set({ role: next, nickname: 'Staff Member' });
  logAudit('CHANGE_ROLE', `Updated role for ${id} to ${next}`);
  render();
}

// Boot Application
window.addEventListener('DOMContentLoaded', init);
</script>
